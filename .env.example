# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Multi-Key Gemini Pool Configurations (up to 10 keys)
VITE_GEMINI_KEY_1=""
VITE_GEMINI_KEY_2=""
VITE_GEMINI_KEY_3=""
VITE_GEMINI_KEY_4=""
VITE_GEMINI_KEY_5=""
VITE_GEMINI_KEY_6=""
VITE_GEMINI_KEY_7=""
VITE_GEMINI_KEY_8=""
VITE_GEMINI_KEY_9=""
VITE_GEMINI_KEY_10=""

GEMINI_KEY_1=""
GEMINI_KEY_2=""
GEMINI_KEY_3=""
GEMINI_KEY_4=""
GEMINI_KEY_5=""
GEMINI_KEY_6=""
GEMINI_KEY_7=""
GEMINI_KEY_8=""
GEMINI_KEY_9=""
GEMINI_KEY_10=""


# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase Configurations
VITE_SUPABASE_URL="https://your-project-id.supabase.co"

# The anon key is public by design — it ships inside the browser bundle and is
# protected by row-level security, not by secrecy.
VITE_SUPABASE_ANON_KEY="your-anon-key-here"

# The service_role key is NOT public. It bypasses row-level security entirely,
# so it belongs on the server and must never be prefixed with VITE_ or reach a
# browser. Copy it from Supabase -> Project Settings -> API -> service_role.
#
# This line was missing from this file, which is how the real .env came to hold
# the anon key in both variables. The server then ran every privileged path --
# webhook lead ingestion, the payment write-back after a verified Razorpay
# signature, the admin routes, the hourly trial-expiry job -- with the rights of
# a logged-out visitor, and row-level security refused them quietly. server.ts
# refuses to start in production if what it finds here is not a service_role key.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"

# The direct Postgres connection, used by the proof scripts in scripts/.
DATABASE_URL="postgresql://postgres:PASSWORD@db.your-project-id.supabase.co:5432/postgres"

# Founder & Internal Team Emails
MASTER_FOUNDER_EMAIL=your_founder_email
INTERNAL_TEAM_EMAILS=email1,email2,email3
CSRF_SECRET=your_csrf_secret
SENTRY_DSN=your_sentry_dsn

# Razorpay Configuration
VITE_RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"

# Cloudflare R2 Document Storage Configuration (Server-side ONLY; never prefix with VITE_)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""


