# Copy to .env and fill in. Both are read at build time by Expo, not at runtime,
# so changing them means rebuilding.
#
# EXPO_PUBLIC_ variables are embedded in the app bundle and are readable by
# anyone who downloads it. The anon key is designed for that -- it is the key
# the browser uses too, and row-level security is what actually protects the
# data. Never put the service role key here.

EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
