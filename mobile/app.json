{
  "expo": {
    "name": "CallMind Telecaller",
    "slug": "callmind",
    "owner": "callminds-team",
    "version": "2.4.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "callmind",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f172a"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.callmind.telecaller"
    },
    "android": {
      "package": "com.callmind.telecaller",
      "adaptiveIcon": {
        "backgroundColor": "#0f172a",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "POST_NOTIFICATIONS",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "VIBRATE",
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false,
          "locationWhenInUsePermission": "CallMind uses your location only when you mark attendance, to record where you punched in."
        }
      ],
      "expo-notifications"
    ],
    "extra": {
      "eas": {
        "projectId": "f498a261-1c85-4ff1-91e9-66ba37ef65bf"
      }
    }
  }
}
